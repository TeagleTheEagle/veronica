# VERONICA's settings. Copy this file to .env in this folder and put your own values after the = signs.
# .env is ignored by git, and VERONICA never prints it. The tests VERONICA runs never see these values.

# Claude (Anthropic). Leave it out if you have signed in with `ant auth login` instead.
ANTHROPIC_API_KEY=

# Fish Audio, for VERONICA's voice. Without a key, Windows' own voice speaks instead.
FISH_API_KEY=
FISH_VOICE_ID=

# Gmail (an app password from myaccount.google.com/apppasswords) and Google Calendar (the calendar's secret
# address in iCal format, from its settings in Google Calendar).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GOOGLE_CALENDAR_ICS=

# Web search for research (Brave Search API) and maps (Google Maps Embed API).
BRAVE_API_KEY=
GOOGLE_MAPS_EMBED_KEY=

# Optional
# FISH_MODEL=s2.1-pro            (on Fish Audio's free plan: s2.1-pro-free)
# VERONICA_EFFORT=high           (low, medium, high, xhigh, max: how hard Claude thinks)
# VERONICA_WINDOWS_VOICE=Zira    (the Windows voice used when Fish Audio is not)
# Research task limits:
# VERONICA_TASK_MAX_STEPS=40         (model calls per task)
# VERONICA_TASK_MAX_MINUTES=20       (running time per task)
# VERONICA_TASK_MAX_COST_USD=3.00    (Claude usage per task, from the usage Claude reports)
# VERONICA_TASK_MAX_ATTEMPTS=3       (tries after temporary failures)
