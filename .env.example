# VERONICA's settings. Copy this file to .env in this folder and put your own values after the = signs.
# .env is ignored by git, and VERONICA never prints it. The tests VERONICA runs never see these values.

# Claude (Anthropic). Leave it out if you have signed in with `ant auth login` instead.
ANTHROPIC_API_KEY=

# Fish Audio, for VERONICA's voice. Without a key, Windows' own voice speaks instead.
FISH_API_KEY=
FISH_VOICE_ID=

# Gmail (an app password from myaccount.google.com/apppasswords) and Google Calendar (the calendar's secret
# address in iCal format, from its settings in Google Calendar).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GOOGLE_CALENDAR_ICS=

# OpenRouter, for all her thinking. Which model does which job is locked in models.py (the owner's guide of
# 2026-10-13; DeepSeek V4 Pro from 2026-10-14): DeepSeek V4 Pro for chat, coding and research, Xiaomi
# MiMo-V2.6-Flash for her helpers (2026-10-14; Haiku 5.5 before), Gemini 3.1 Flash-Lite as
# the backup from another maker. The lines below may
# swap a job to another model from that list only (deepseek/deepseek-v4-pro, anthropic/claude-sonnet-5.5, anthropic/claude-opus-5.5,
# anthropic/claude-haiku-5.5, xiaomi/mimo-v2.6-flash, google/gemini-3.1-flash-lite, google/gemini-3.1-pro-preview,
# asi1-mini); any other name is ignored.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro
# OPENROUTER_CODING_MODEL=deepseek/deepseek-v4-pro
# OPENROUTER_RESEARCH_MODEL=deepseek/deepseek-v4-pro
# OPENROUTER_HELPER_MODEL=xiaomi/mimo-v2.6-flash

# ASI:One (Fetch.ai), an extra model: asi1-mini. Not on OpenRouter; it has its own key from asi1.ai. To use it, put
# the key here and name asi1-mini in one of the lines above (for example OPENROUTER_HELPER_MODEL=asi1-mini).
ASI_ONE_API_KEY=

# Web search (Brave Search API: chat, the researcher and research tasks) and maps (Google Maps Embed API).
BRAVE_API_KEY=
GOOGLE_MAPS_EMBED_KEY=

# Optional
# FISH_MODEL=s2.1-pro            (on Fish Audio's free plan: s2.1-pro-free)
# VERONICA_EFFORT=high           (low, medium, high, xhigh, max: how hard Claude thinks)
# VERONICA_WINDOWS_VOICE=Zira    (the Windows voice used when Fish Audio is not)
# Research task limits:
# VERONICA_TASK_MAX_STEPS=40         (model calls per task)
# VERONICA_TASK_MAX_MINUTES=20       (running time per task)
# VERONICA_TASK_MAX_COST_USD=3.00    (Claude usage per task, from the usage Claude reports)
# VERONICA_TASK_MAX_ATTEMPTS=3       (tries after temporary failures)
